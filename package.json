{
  "name": "dn-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Local Dragon Nest weekly nest run tracker",
  "scripts": {
    "dev": "tsx watch server/src/dev.mts",
    "seed:dev": "tsx server/src/seed-dev.ts",
    "build": "tsc -p server/tsconfig.json && tsc -p server/tsconfig.dev.json && tsc -p web/tsconfig.json --noEmit && vite build",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "supertest": "^7.3.1"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true
  }
}
